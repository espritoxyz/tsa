#include "../../imports/stdlib.fc";
#include "../../imports/tsa_functions.fc";

const int VULNERABILITY_FOUND = 1000;
const int VULNERABILITY_NOT_FOUND = 500;


global int expected_opcode;

global slice initial_sender; ;; only set if `~ use_external_msg`

() on_internal_message_send(int balance, int msg_value, cell in_msg_full, slice msg_body, int input_id) impure method_id {
    var opcode = msg_body.preload_uint(32);
    tsa_assert(opcode == expected_opcode);

    slice cs = in_msg_full.begin_parse();
    cs~load_uint(4); ;; flags
    initial_sender = cs~load_msg_addr();
}

global int out_msg_counter;

() on_out_message(int msg_id, int counter, cell msg_full, slice msg_body, int receiver_contract_id, int sender_contract_id) impure method_id {
    if ((sender_contract_id != 1) | (receiver_contract_id != -1)) {
        return ();
    }
    if (tsa_fork_without_solver(0, 1) == 0) {
        ;; we split on whether this particular message is symbolic;
        ;; we cannot do this for all the message, as the fact that the message destination is random
        ;; is found out by the fact that the state did not die in the postprocess
        slice cs = msg_full.begin_parse();
        cs~load_uint(4); ;; flags
        cs~load_msg_addr(); ;; source
        slice dest = cs~load_msg_addr();
        tsa_make_address_random(dest);
        cell c4 = tsa_get_c4(1);
        tsa_fetch_value(msg_id, out_msg_counter);
        tsa_make_slice_independent_from_random_addresses(c4.begin_parse());
        tsa_make_slice_independent_from_random_addresses(initial_sender);
        ;; non-random addresses die at postprocess
    }
    out_msg_counter = out_msg_counter + 1;
}

() main() impure {
    var ds = get_data().begin_parse();
    expected_opcode = ds~load_uint(32);
    out_msg_counter = 0;
    tsa_forbid_failures();
    var balance = tsa_get_balance(1);
    tsa_assert(balance >= 1000000000); ;; 1 ton
    tsa_send_internal_message(1, 0);
    tsa_allow_failures();
    ;; if no messages are sent, no state dies during postprocess; here is a fix for it
    throw_if(VULNERABILITY_FOUND, out_msg_counter >= 1);
}
